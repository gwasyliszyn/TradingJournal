{
    "permissions": {
        "allow": [
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(node *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git status *)",
            "Bash(git branch *)",
            "Bash(git checkout *)",
            "Bash(git stash *)",
            "Read",
            "Edit",
            "Write"
        ],
        "ask": [
            "Bash(curl *)",
            "Bash(wget *)",
            "Bash(git push *)",
            "Bash(git push)",
            "Bash(rm -rf *)"
        ],
        "deny": []
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/eslint-hook.sh",
                        "timeout": 30,
                        "statusMessage": "Running ESLint --fix..."
                    },
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/typecheck-hook.sh",
                        "timeout": 60,
                        "statusMessage": "Running TypeScript typecheck..."
                    }
                ]
            }
        ]
    }
}