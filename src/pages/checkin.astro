---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getTodayCheckin } from "@/lib/services/checkin";
import CheckinForm from "@/components/checkin/CheckinForm";

const { user } = Astro.locals;
let checkin = null;

if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    const result = await getTodayCheckin(supabase, user.id);
    checkin = result?.checkin ?? null;
  }
}
---

<Layout title="Check-in">
  <div class="bg-background text-foreground flex min-h-screen items-start justify-center px-4 pt-12">
    <div class="w-full max-w-lg space-y-6">
      <h1 class="text-center text-2xl font-bold tracking-tight">Pre-market Check-in</h1>
      <CheckinForm client:load existingCheckin={checkin} />
    </div>
  </div>
</Layout>
