---
import Layout from "@/layouts/Layout.astro";
import Stepper from "@/components/Stepper.astro";
import { createClient } from "@/lib/supabase";
import { getCheckinBySession } from "@/lib/services/checkin";
import { getScoreBand } from "@/lib/services/readiness-score";
import { getPlanBySession } from "@/lib/services/plan";
import { getTradesBySession } from "@/lib/services/trades";
import { getReviewBySession } from "@/lib/services/review";
import { getProcessScoreBand } from "@/lib/services/process-score";

const { user } = Astro.locals;
let checkinExists = false;
let readinessScore: number | null = null;
let bandLabel: string | null = null;
let bandColorClass: string | null = null;
let planGoal: string | null = null;
let planExists = false;
let tradeCount = 0;
let tradesExist = false;
let reviewExists = false;
let processScore: number | null = null;
let reviewBandLabel: string | null = null;
let reviewBandColorClass: string | null = null;

if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    try {
      const today = new Date().toISOString().split("T")[0];
      // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
      const { data: session } = await supabase
        .from("sessions")
        .select()
        .eq("user_id", user.id)
        .eq("session_date", today)
        .maybeSingle();

      if (session) {
        const [checkin, plan, trades, review] = await Promise.all([
          // eslint-disable-next-line @typescript-eslint/no-unsafe-argument, @typescript-eslint/no-unsafe-member-access
          getCheckinBySession(supabase, session.id),
          // eslint-disable-next-line @typescript-eslint/no-unsafe-argument, @typescript-eslint/no-unsafe-member-access
          getPlanBySession(supabase, session.id),
          // eslint-disable-next-line @typescript-eslint/no-unsafe-argument, @typescript-eslint/no-unsafe-member-access
          getTradesBySession(supabase, session.id),
          // eslint-disable-next-line @typescript-eslint/no-unsafe-argument, @typescript-eslint/no-unsafe-member-access
          getReviewBySession(supabase, session.id),
        ]);

        if (checkin) {
          checkinExists = true;
          readinessScore = checkin.readiness_score;
          const band = getScoreBand(readinessScore);
          bandLabel = band.label;
          bandColorClass = band.colorClass;
        }

        if (plan) {
          planExists = true;
          planGoal = plan.goal;
        }

        if (trades.length > 0) {
          tradesExist = true;
          tradeCount = trades.length;
        }

        if (review) {
          reviewExists = true;
          processScore = review.process_score;
          const band = getProcessScoreBand(processScore);
          reviewBandLabel = band.label;
          reviewBandColorClass = band.colorClass;
        }
      }
    } catch {
      // Supabase unavailable — degrade gracefully
    }
  }
}

const allComplete = checkinExists && planExists && tradesExist && reviewExists;

const steps = [
  { label: "Check-in", href: "/checkin", completed: checkinExists },
  { label: "Plan", href: "/plan", completed: planExists },
  { label: "Trades", href: "/trades", completed: tradesExist },
  { label: "Review", href: "/review", completed: reviewExists },
];

const nextStep = steps.find((s) => !s.completed);

const stepDetails = [
  {
    label: "Pre-market Check-in",
    href: "/checkin",
    completed: checkinExists,
    summary:
      checkinExists && readinessScore !== null && bandColorClass && bandLabel
        ? { text: `${readinessScore} — ${bandLabel}`, colorClass: bandColorClass }
        : null,
  },
  {
    label: "Session Plan",
    href: "/plan",
    completed: planExists,
    summary: planExists && planGoal ? { text: planGoal, colorClass: null } : null,
  },
  {
    label: "Trades",
    href: "/trades",
    completed: tradesExist,
    summary: tradesExist
      ? { text: `${tradeCount} ${tradeCount === 1 ? "trade" : "trades"} logged`, colorClass: null }
      : null,
  },
  {
    label: "Post-session Review",
    href: "/review",
    completed: reviewExists,
    summary:
      reviewExists && processScore !== null && reviewBandColorClass && reviewBandLabel
        ? { text: `${processScore} — ${reviewBandLabel}`, colorClass: reviewBandColorClass }
        : null,
  },
];

const nextStepDescriptions: Record<string, string> = {
  "Check-in": "Rate your sleep, energy, stress, and focus to get your Readiness Score before trading.",
  Plan: "Set your session goal, max trades, and max daily loss to stay disciplined.",
  Trades: "Log your trades with instrument, setup, result, and plan compliance.",
  Review: "Reflect on your session to calculate your Process Score.",
};
---

<Layout title="Today">
  <div class="bg-background text-foreground flex min-h-screen items-start justify-center px-4 pt-12">
    <div class="w-full max-w-lg space-y-6">
      <h1 class="text-center text-2xl font-bold tracking-tight">Today</h1>

      <div class="bg-card rounded-xl border p-6 shadow-sm">
        <Stepper steps={steps} />
      </div>

      {
        allComplete ? (
          <div class="bg-card rounded-xl border p-6 shadow-sm">
            <h2 class="mb-4 text-center font-semibold">Session Complete</h2>
            <div class="grid grid-cols-2 gap-4">
              <div class="text-center">
                <p class="text-muted-foreground mb-1 text-xs font-medium tracking-wider uppercase">Readiness</p>
                <p class="text-3xl font-bold">{readinessScore}</p>
                {bandColorClass && bandLabel && (
                  <span
                    class:list={[
                      "mt-1 inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium",
                      bandColorClass,
                    ]}
                  >
                    {bandLabel}
                  </span>
                )}
              </div>
              <div class="text-center">
                <p class="text-muted-foreground mb-1 text-xs font-medium tracking-wider uppercase">Process</p>
                <p class="text-3xl font-bold">{processScore}</p>
                {reviewBandColorClass && reviewBandLabel && (
                  <span
                    class:list={[
                      "mt-1 inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium",
                      reviewBandColorClass,
                    ]}
                  >
                    {reviewBandLabel}
                  </span>
                )}
              </div>
            </div>
          </div>
        ) : nextStep ? (
          <div class="bg-card rounded-xl border p-6 shadow-sm">
            <h2 class="mb-1 font-semibold">Next: {nextStep.label}</h2>
            <p class="text-muted-foreground mb-4 text-sm">{nextStepDescriptions[nextStep.label]}</p>
            <a
              href={nextStep.href}
              class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 w-full items-center justify-center rounded-md text-sm font-medium shadow-xs"
            >
              Start {nextStep.label}
            </a>
          </div>
        ) : null
      }

      <div class="space-y-2">
        {
          stepDetails.map((step) => (
            <div class="bg-card flex items-center justify-between rounded-lg border px-4 py-3">
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    "flex h-5 w-5 items-center justify-center rounded-full text-xs",
                    step.completed ? "bg-green-100 text-green-700" : "bg-muted text-muted-foreground",
                  ]}
                >
                  {step.completed ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-3.5 w-3.5"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  ) : (
                    <span class="h-1.5 w-1.5 rounded-full bg-current" />
                  )}
                </span>
                <div>
                  <p class="text-sm font-medium">{step.label}</p>
                  {step.summary ? (
                    step.summary.colorClass ? (
                      <span
                        class:list={[
                          "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium",
                          step.summary.colorClass,
                        ]}
                      >
                        {step.summary.text}
                      </span>
                    ) : (
                      <p class="text-muted-foreground text-xs">{step.summary.text}</p>
                    )
                  ) : (
                    <p class="text-muted-foreground text-xs">Pending</p>
                  )}
                </div>
              </div>
              <a href={step.href} class="text-primary text-sm font-medium hover:underline">
                {step.completed ? "Edit" : "Start"}
              </a>
            </div>
          ))
        }
      </div>

      <div class="text-center">
        <a href="/history" class="text-muted-foreground text-sm underline-offset-4 hover:underline">
          Session History
        </a>
      </div>

      <form method="POST" action="/api/auth/signout" class="text-center">
        <button type="submit" class="text-muted-foreground text-sm underline-offset-4 hover:underline">
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
