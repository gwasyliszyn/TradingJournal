---
interface Step {
  label: string;
  href: string;
  completed: boolean;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;

const currentIndex = steps.findIndex((s) => !s.completed);
---

<nav aria-label="Session progress" class="w-full">
  <ol class="flex items-center justify-between">
    {
      steps.map((step, i) => {
        const isCurrent = i === currentIndex;
        const isPending = !step.completed && !isCurrent;

        return (
          <li class="flex flex-1 items-center">
            <a
              href={step.href}
              aria-current={isCurrent ? "step" : undefined}
              class:list={["group flex w-full flex-col items-center gap-1.5", isPending && "opacity-50"]}
            >
              <span
                class:list={[
                  "flex h-8 w-8 items-center justify-center rounded-full border-2 text-sm font-semibold transition-colors",
                  step.completed && "border-green-600 bg-green-100 text-green-700",
                  isCurrent && "border-primary bg-primary text-primary-foreground",
                  isPending && "border-muted-foreground/30 bg-muted text-muted-foreground",
                ]}
              >
                {step.completed ? (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"
                    />
                  </svg>
                ) : (
                  i + 1
                )}
              </span>
              <span
                class:list={[
                  "text-center text-xs font-medium",
                  step.completed && "text-green-700",
                  isCurrent && "text-foreground",
                  isPending && "text-muted-foreground",
                ]}
              >
                {step.label}
              </span>
            </a>
            {i < steps.length - 1 && (
              <div class:list={["mx-1 mt-[-1.25rem] h-0.5 flex-1", step.completed ? "bg-green-400" : "bg-muted"]} />
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
